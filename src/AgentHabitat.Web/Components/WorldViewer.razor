@using AgentHabitat.Web.Services
@inject WorldService WorldSvc
@inject IJSRuntime JS

<div class="habitat-shell">
    <div class="habitat-header">
        <h1>AgentHabitat</h1>
        <span class="subtitle">2D world generator · AI agent spaces</span>
    </div>

    <div class="habitat-controls">
        <label>Preset</label>
        <select @bind="SelectedPreset" @bind:after="OnPresetChanged">
            @foreach (var (id, preset) in WorldService.Presets)
            {
                <option value="@id">@preset.Name</option>
            }
        </select>

        <label>Seed</label>
        <input @bind="Seed" @bind:event="oninput" placeholder="alpha-001" disabled="@(_selectedPreset != "custom")" />

        <label>Style</label>
        <select @bind="Style" disabled="@(_selectedPreset != "custom")">
            <option value="retro-office">Retro Office</option>
            <option value="forest-lab">Forest Lab</option>
            <option value="neon-hq">Neon HQ</option>
        </select>

        <button class="habitat-btn-primary" @onclick="Generate">Generate</button>
        <button class="habitat-btn-secondary" @onclick="ToggleMinimap">
            Minimap @(_showMinimap ? "ON" : "OFF")
        </button>
    </div>

    @if (_selectedPreset != "custom")
    {
        <div class="habitat-hint" style="margin-bottom:var(--sp-3)">
            @(WorldService.Presets[_selectedPreset].Description)
        </div>
    }

    @if (_renderData != null)
    {
        <div class="habitat-stats">
            <span>Rooms <strong>@_renderData.Rooms.Length</strong></span>
            <span>Agents <strong>@_renderData.Agents.Length</strong></span>
            <span>Objects <strong>@_renderData.Objects.Length</strong></span>
            <span>Grid <strong>@(_renderData.Width)×@(_renderData.Height)</strong></span>
            <span>Hash <strong style="font:var(--text-mono)">@_renderData.TopologyHash[..12]</strong></span>
        </div>

        <div class="habitat-agents">
            @foreach (var agent in _renderData.Agents)
            {
                <div class="habitat-agent-card">
                    <div class="dot" style="background:@agent.Color"></div>
                    <span class="name" style="color:@agent.Color">@agent.Name</span>
                    <span class="role">@agent.Role</span>
                    <div class="status-dot" style="background:@(agent.Status == "active" ? "var(--accent-green)" : agent.Status == "idle" ? "#eab308" : "var(--text-dim)")"></div>
                </div>
            }
        </div>
    }

    <div class="habitat-main">
        <div class="habitat-canvas-wrap">
            <canvas id="world-canvas"></canvas>
        </div>

        @if (_selectedRoom != null)
        {
            <div class="habitat-panel">
                <h3>@_selectedRoom.Archetype.Replace("Room", " Room")</h3>
                <div class="meta">
                    @_selectedRoom.Id — @(_selectedRoom.Width)×@(_selectedRoom.Height) at (@_selectedRoom.X, @_selectedRoom.Y)
                </div>

                @if (_selectedRoomAgents.Length > 0)
                {
                    <div style="margin-bottom:var(--sp-3)">
                        <div class="section-label">Agents</div>
                        @foreach (var agent in _selectedRoomAgents)
                        {
                            <div style="display:flex;align-items:center;gap:var(--sp-2);padding:var(--sp-1) 0">
                                <div class="dot" style="width:6px;height:6px;border-radius:50%;background:@agent.Color"></div>
                                <span style="color:@agent.Color;font-weight:600;font:var(--text-caption)">@agent.Name</span>
                                <span style="color:var(--text-dim);font:var(--text-caption)">@agent.Role</span>
                            </div>
                        }
                    </div>
                }

                @if (_selectedRoomObjects.Length > 0)
                {
                    <div>
                        <div class="section-label">Furniture</div>
                        <div style="display:flex;gap:var(--sp-1);flex-wrap:wrap">
                            @foreach (var obj in _selectedRoomObjects.GroupBy(o => o.Type))
                            {
                                <span class="habitat-tag">@obj.Key ×@obj.Count()</span>
                            }
                        </div>
                    </div>
                }

                <button class="habitat-btn-secondary" style="width:100%;margin-top:var(--sp-3)" @onclick="ClearSelection">
                    Close
                </button>
            </div>
        }
    </div>

    @if (_selectedAgent != null)
    {
        <div class="habitat-modal-backdrop" @onclick="ClearSelection"></div>
        <div class="habitat-modal" style="border:2px solid @_selectedAgent.Color">
            <div class="modal-header">
                <div style="width:16px;height:16px;border-radius:50%;background:@_selectedAgent.Color"></div>
                <h3 style="margin:0;font:var(--text-heading)">@_selectedAgent.Name</h3>
                <div style="width:8px;height:8px;border-radius:50%;background:@(_selectedAgent.Status == "active" ? "var(--accent-green)" : _selectedAgent.Status == "idle" ? "#eab308" : "var(--text-dim)")"></div>
            </div>
            <div class="modal-grid">
                <span>Role</span><span class="value">@_selectedAgent.Role</span>
                <span>Status</span><span class="value">@_selectedAgent.Status</span>
                <span>Position</span><span class="value">(@_selectedAgent.X, @_selectedAgent.Y)</span>
                <span>ID</span><span class="value" style="font:var(--text-mono)">@_selectedAgent.Id</span>
            </div>
            <div class="modal-actions">
                <button class="habitat-btn-primary" style="flex:1" @onclick="() => MoveSelectedAgent()">
                    Move Agent
                </button>
                <button class="habitat-btn-secondary" style="flex:1" @onclick="ClearSelection">
                    Close
                </button>
            </div>
        </div>
    }

    @if (_selectedRoom == null && _selectedAgent == null)
    {
        <div class="habitat-hint">Click a room or agent to inspect · Right-click to move selected agent</div>
    }
</div>

@code {
    private string _selectedPreset = "startup-office";
    private string SelectedPreset { get => _selectedPreset; set => _selectedPreset = value; }
    private string Seed { get; set; } = "startup-hq";
    private string Style { get; set; } = "retro-office";
    private bool _showMinimap = true;
    private WorldRenderData? _renderData;
    private RoomRenderData? _selectedRoom;
    private AgentRenderData? _selectedAgent;
    private AgentRenderData[] _selectedRoomAgents = [];
    private ObjectRenderData[] _selectedRoomObjects = [];
    private DotNetObjectReference<WorldViewer>? _selfRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            await Generate();
        }
    }

    private async Task Generate()
    {
        var world = WorldSvc.Generate(Seed, Style);
        _renderData = WorldSvc.ToRenderData(world);
        _selectedRoom = null;
        _selectedAgent = null;
        StateHasChanged();
        await JS.InvokeVoidAsync("WorldRenderer.render", "world-canvas", _renderData);
    }

    private async Task OnPresetChanged()
    {
        if (WorldService.Presets.TryGetValue(_selectedPreset, out var preset))
        {
            Seed = preset.Seed;
            Style = preset.Style;
            await Generate();
        }
    }

    private async Task ToggleMinimap()
    {
        _showMinimap = !_showMinimap;
        await JS.InvokeVoidAsync("eval", $"document.getElementById('world-canvas')._showMinimap = {(_showMinimap ? "true" : "false")}");
        if (_renderData != null)
            await JS.InvokeVoidAsync("WorldRenderer.render", "world-canvas", _renderData);
    }

    private void ClearSelection()
    {
        _selectedRoom = null;
        _selectedAgent = null;
        _selectedRoomAgents = [];
        _selectedRoomObjects = [];
        StateHasChanged();
    }

    private async Task MoveSelectedAgent()
    {
        if (_selectedAgent == null || _renderData == null) return;
        var rng = new Random();
        var targetRoom = _renderData.Rooms[rng.Next(_renderData.Rooms.Length)];
        await JS.InvokeVoidAsync("WorldRenderer.moveAgent", "world-canvas",
            _selectedAgent.Id, targetRoom.X + targetRoom.Width / 2, targetRoom.Y + targetRoom.Height / 2);
        ClearSelection();
    }

    public void Dispose()
    {
        _selfRef?.Dispose();
    }
}
