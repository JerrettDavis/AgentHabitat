@using AgentHabitat.Web.Services
@using AgentHabitat.Core.WorldGen.Contracts
@inject WorldService WorldSvc
@inject IJSRuntime JS
@inject PresenceService Presence

<div class="habitat-shell">
    <div class="habitat-header">
        <h1>AgentHabitat</h1>
        <span class="subtitle">2D world generator · AI agent spaces</span>
    </div>

    <div class="habitat-controls">
        <label>Preset</label>
        <select @bind="SelectedPreset" @bind:after="OnPresetChanged">
            @foreach (var (id, preset) in WorldService.Presets)
            {
                <option value="@id">@preset.Name</option>
            }
        </select>

        <label>Seed</label>
        <input @bind="Seed" @bind:event="oninput" placeholder="alpha-001" disabled="@(_selectedPreset != "custom")" />

        <label>Style</label>
        <select @bind="Style" disabled="@(_selectedPreset != "custom")">
            <option value="retro-office">Retro Office</option>
            <option value="forest-lab">Forest Lab</option>
            <option value="neon-hq">Neon HQ</option>
        </select>

        <button class="habitat-btn-primary" @onclick="Generate">Generate</button>
        <button class="habitat-btn-secondary" @onclick="ToggleMinimap">
            Minimap @(_showMinimap ? "ON" : "OFF")
        </button>
        <button class="habitat-btn-secondary" @onclick="AddTestAgent">
            + Agent
        </button>
        <button class="@(_editMode ? "habitat-btn-primary" : "habitat-btn-secondary")"
                style="@(_editMode ? "background:var(--accent-orange)" : "")"
                @onclick="ToggleEditMode">
            @(_editMode ? "Exit Edit" : "Edit Mode")
        </button>
    </div>

    @if (_selectedPreset != "custom")
    {
        <div class="habitat-hint" style="margin-bottom:var(--sp-3)">
            @(WorldService.Presets[_selectedPreset].Description)
        </div>
    }

    @if (_renderData != null)
    {
        <div class="habitat-stats">
            <span>Rooms <strong>@_renderData.Rooms.Length</strong></span>
            <span>Agents <strong>@_renderData.Agents.Length</strong></span>
            <span>Objects <strong>@_renderData.Objects.Length</strong></span>
            <span>Doors <strong>@_renderData.Doors.Length</strong></span>
            <span>Grid <strong>@(_renderData.Width)×@(_renderData.Height)</strong></span>
            <span>Hash <strong style="font:var(--text-mono)">@_renderData.TopologyHash[..12]</strong></span>
            @{ var snap = Presence.GetSnapshot(); }
            <span>Online <strong style="color:var(--accent-green)">@snap.ActiveCount</strong>/@snap.TotalCount</span>
        </div>

        <div class="habitat-agents">
            @foreach (var agent in _renderData.Agents)
            {
                <div class="habitat-agent-card">
                    <div class="dot" style="background:@agent.Color"></div>
                    <span class="name" style="color:@agent.Color">@agent.Name</span>
                    <span class="role">@agent.Role</span>
                    <div class="status-dot" style="background:@(agent.Status == "active" ? "var(--accent-green)" : agent.Status == "idle" ? "#eab308" : "var(--text-dim)")"></div>
                </div>
            }
        </div>
    }

    <div class="habitat-main">
        <div class="habitat-canvas-wrap">
            <canvas id="world-canvas"></canvas>
        </div>

        @if (_selectedRoom != null)
        {
            <div class="habitat-panel">
                <h3>@_selectedRoom.Archetype.Replace("Room", " Room")</h3>
                <div class="meta">
                    @_selectedRoom.Id — @(_selectedRoom.Width)×@(_selectedRoom.Height) at (@_selectedRoom.X, @_selectedRoom.Y)
                </div>

                @if (_selectedRoomAgents.Length > 0)
                {
                    <div style="margin-bottom:var(--sp-3)">
                        <div class="section-label">Agents</div>
                        @foreach (var agent in _selectedRoomAgents)
                        {
                            <div style="display:flex;align-items:center;gap:var(--sp-2);padding:var(--sp-1) 0">
                                <div class="dot" style="width:6px;height:6px;border-radius:50%;background:@agent.Color"></div>
                                <span style="color:@agent.Color;font-weight:600;font:var(--text-caption)">@agent.Name</span>
                                <span style="color:var(--text-dim);font:var(--text-caption)">@agent.Role</span>
                            </div>
                        }
                    </div>
                }

                @if (_selectedRoomDoors.Length > 0)
                {
                    <div style="margin-bottom:var(--sp-3)">
                        <div class="section-label">Doors</div>
                        <div style="display:flex;flex-direction:column;gap:var(--sp-1)">
                            @foreach (var door in _selectedRoomDoors)
                            {
                                <div style="display:flex;align-items:center;gap:var(--sp-2);padding:var(--sp-1) 0">
                                    <span style="font:var(--text-caption);color:var(--text-secondary)">@door.Direction</span>
                                    <span class="habitat-tag" style="cursor:pointer;background:@(door.State == "Open" ? "var(--accent-green)" : door.State == "Closed" ? "var(--accent-orange)" : "var(--accent-red)");color:#fff"
                                          @onclick="() => ToggleDoor(door.Id)">
                                        @door.State
                                    </span>
                                    <span style="font:var(--text-caption);color:var(--text-dim)">→ @(door.ConnectsTo ?? "corridor")</span>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (_selectedRoomObjects.Length > 0)
                {
                    <div>
                        <div class="section-label">Furniture</div>
                        <div style="display:flex;gap:var(--sp-1);flex-wrap:wrap">
                            @foreach (var obj in _selectedRoomObjects.GroupBy(o => o.Type))
                            {
                                <span class="habitat-tag">@obj.Key ×@obj.Count()</span>
                            }
                        </div>
                    </div>
                }

                <button class="habitat-btn-secondary" style="width:100%;margin-top:var(--sp-3)" @onclick="ClearSelection">
                    Close
                </button>
            </div>
        }

        @if (_editMode)
        {
            <div class="habitat-panel" style="border-color:var(--accent-orange)">
                <h3 style="color:var(--accent-orange)">Edit Mode</h3>
                <div class="meta">Click an object to select · Use actions below</div>

                <div style="margin-bottom:var(--sp-3)">
                    <div class="section-label">Actions</div>
                    <div style="display:flex;flex-direction:column;gap:var(--sp-2)">
                        <button class="habitat-btn-secondary" @onclick="EditMove" disabled="@(!_hasEditSelection)">
                            Move Selected
                        </button>
                        <button class="habitat-btn-secondary" @onclick="EditRemove" disabled="@(!_hasEditSelection)"
                                style="@(_hasEditSelection ? "color:var(--accent-red);border-color:var(--accent-red)" : "")">
                            Remove Selected
                        </button>
                    </div>
                </div>

                <div style="margin-bottom:var(--sp-3)">
                    <div class="section-label">Persistence</div>
                    <div style="display:flex;gap:var(--sp-2)">
                        <button class="habitat-btn-primary" style="flex:1;font-size:11px" @onclick="SaveEdits">
                            Save Layout
                        </button>
                        <button class="habitat-btn-secondary" style="flex:1" @onclick="ResetEdits">
                            Reset
                        </button>
                    </div>
                    @if (_saveStatus != null)
                    {
                        <div style="margin-top:var(--sp-2);font:var(--text-caption);color:@(_saveStatus == "ok" ? "var(--accent-green)" : "var(--accent-red)")">
                            @(_saveStatus == "ok" ? "Layout saved · invariants pass" : "Save failed — check invariants")
                        </div>
                    }
                </div>

                <div style="margin-bottom:var(--sp-3)">
                    <div class="section-label">Validation</div>
                    <button class="habitat-btn-secondary" style="width:100%;font-size:11px" @onclick="RunValidation">
                        Check Invariants
                    </button>
                    @if (_validationErrors != null)
                    {
                        <div style="margin-top:var(--sp-1);font:var(--text-caption);color:@(_validationErrors.Length == 0 ? "var(--accent-green)" : "var(--accent-red)")">
                            @if (_validationErrors.Length == 0)
                            {
                                <span>All invariants pass (overlap · bounds · reachability)</span>
                            }
                            else
                            {
                                @foreach (var err in _validationErrors)
                                {
                                    <div>· @err</div>
                                }
                            }
                        </div>
                    }
                </div>

                <div>
                    <div class="section-label">Add Object</div>
                    <div style="display:flex;gap:var(--sp-1);flex-wrap:wrap">
                        @foreach (var objType in new[] { "desk", "chair", "plant", "lamp", "bookshelf", "couch", "table", "rug", "clock", "mug", "trash" })
                        {
                            <button class="habitat-tag" style="cursor:pointer" @onclick="() => EditAdd(objType)">
                                + @objType
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (_selectedAgent != null)
    {
        <div class="habitat-modal-backdrop" @onclick="ClearSelection"></div>
        <div class="habitat-modal" style="border:2px solid @_selectedAgent.Color">
            <div class="modal-header">
                <div style="width:16px;height:16px;border-radius:50%;background:@_selectedAgent.Color"></div>
                <h3 style="margin:0;font:var(--text-heading)">@_selectedAgent.Name</h3>
                <div style="width:8px;height:8px;border-radius:50%;background:@(_selectedAgent.Status == "active" ? "var(--accent-green)" : _selectedAgent.Status == "idle" ? "#eab308" : "var(--text-dim)")"></div>
            </div>
            <div class="modal-grid">
                <span>Role</span><span class="value">@_selectedAgent.Role</span>
                <span>Status</span><span class="value">@_selectedAgent.Status</span>
                <span>Position</span><span class="value">(@_selectedAgent.X, @_selectedAgent.Y)</span>
                <span>ID</span><span class="value" style="font:var(--text-mono)">@_selectedAgent.Id</span>
            </div>
            <div class="modal-actions">
                <button class="habitat-btn-primary" style="flex:1" @onclick="() => MoveSelectedAgent()">
                    Move Agent
                </button>
                <button class="habitat-btn-secondary" style="flex:1" @onclick="ClearSelection">
                    Close
                </button>
            </div>
        </div>
    }

    @if (_selectedRoom == null && _selectedAgent == null)
    {
        <div class="habitat-hint">Click a room or agent to inspect · Click doors to toggle state · Right-click to move selected agent</div>
    }
</div>

@code {
    private string _selectedPreset = "startup-office";
    private string SelectedPreset { get => _selectedPreset; set => _selectedPreset = value; }
    private string Seed { get; set; } = "startup-hq";
    private string Style { get; set; } = "retro-office";
    private bool _showMinimap = true;
    private bool _editMode = false;
    private bool _hasEditSelection = false;
    private string? _savedOverrides = null;
    private string? _saveStatus = null;
    private string[]? _validationErrors = null;
    private WorldRenderData? _renderData;
    private WorldGenerationResult? _lastWorld;
    private int _testAgentCounter = 0;
    private RoomRenderData? _selectedRoom;
    private AgentRenderData? _selectedAgent;
    private AgentRenderData[] _selectedRoomAgents = [];
    private ObjectRenderData[] _selectedRoomObjects = [];
    private DoorRenderData[] _selectedRoomDoors = [];
    private DotNetObjectReference<WorldViewer>? _selfRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            await Generate();
        }
    }

    private async Task Generate()
    {
        WorldSvc.ClearOwnership();
        _lastWorld = WorldSvc.Generate(Seed, Style);
        _renderData = WorldSvc.ToRenderData(_lastWorld);
        _selectedRoom = null;
        _selectedAgent = null;
        _editMode = false;
        _hasEditSelection = false;
        _saveStatus = null;
        _validationErrors = null;
        _testAgentCounter = 0;
        StateHasChanged();
        // Reset base snapshot for override layer
        await JS.InvokeVoidAsync("eval", "document.getElementById('world-canvas')._baseObjects = null");
        await JS.InvokeVoidAsync("WorldRenderer.render", "world-canvas", _renderData);
        await JS.InvokeVoidAsync("WorldRenderer.startIdleAnimation", "world-canvas");

        // Initialize presence for all agents
        if (_renderData != null)
        {
            Presence.SimulatePresence(_renderData.Agents
                .Select(a => (a.Id, a.X, a.Y, a.Status)));
        }
        // Initialize privacy policies for all offices
        await JS.InvokeVoidAsync("WorldRenderer.initializePrivacy", "world-canvas");
    }

    private async Task ToggleEditMode()
    {
        _editMode = !_editMode;
        _hasEditSelection = false;
        await JS.InvokeVoidAsync("WorldRenderer.setEditMode", "world-canvas", _editMode);
    }

    private async Task EditMove()
    {
        await JS.InvokeVoidAsync("WorldRenderer.setEditAction", "world-canvas", "move", null);
    }

    private async Task EditRemove()
    {
        await JS.InvokeVoidAsync("WorldRenderer.removeSelectedObject", "world-canvas");
        _hasEditSelection = false;
        StateHasChanged();
    }

    private async Task SaveEdits()
    {
        var json = await JS.InvokeAsync<string>("WorldRenderer.saveOverrides", "world-canvas");
        _savedOverrides = json;
        // Check if invariants passed in the saved data
        _saveStatus = json.Contains("\"invariantsPass\":true") ? "ok" : "fail";
        StateHasChanged();
    }

    private async Task ResetEdits()
    {
        await JS.InvokeVoidAsync("WorldRenderer.resetOverrides", "world-canvas");
        _hasEditSelection = false;
        StateHasChanged();
    }

    private async Task EditAdd(string objType)
    {
        await JS.InvokeVoidAsync("WorldRenderer.setEditAction", "world-canvas", "add", objType);
    }

    private async Task RunValidation()
    {
        var result = await JS.InvokeAsync<ValidationResult>("WorldRenderer.validateInvariants", "world-canvas");
        _validationErrors = result.Pass ? [] : result.Errors;
        StateHasChanged();
    }

    private record ValidationResult(bool Pass, string[] Errors);

    private async Task OnPresetChanged()
    {
        if (WorldService.Presets.TryGetValue(_selectedPreset, out var preset))
        {
            Seed = preset.Seed;
            Style = preset.Style;
            await Generate();
        }
    }

    private async Task AddTestAgent()
    {
        if (_lastWorld == null || _renderData == null) return;
        _testAgentCounter++;
        var newAgent = new AgentDefinition(
            $"agent-{_testAgentCounter}",
            $"Agent {_testAgentCounter}",
            _testAgentCounter % 3 == 0 ? "Triage" : _testAgentCounter % 2 == 0 ? "Assistant" : "Developer"
        );
        var updated = WorldSvc.AddAgentToWorld(_lastWorld, newAgent);
        if (updated != null)
        {
            _renderData = updated;
            _selectedRoom = null;
            _selectedAgent = null;
            StateHasChanged();
            await JS.InvokeVoidAsync("eval", "document.getElementById('world-canvas')._baseObjects = null");
            await JS.InvokeVoidAsync("WorldRenderer.render", "world-canvas", _renderData);
        }
    }

    private async Task ToggleMinimap()
    {
        _showMinimap = !_showMinimap;
        await JS.InvokeVoidAsync("eval", $"document.getElementById('world-canvas')._showMinimap = {(_showMinimap ? "true" : "false")}");
        if (_renderData != null)
            await JS.InvokeVoidAsync("WorldRenderer.render", "world-canvas", _renderData);
    }

    private async Task ToggleDoor(string doorId)
    {
        await JS.InvokeVoidAsync("WorldRenderer.toggleDoor", "world-canvas", doorId);
        // Refresh door states in panel
        if (_selectedRoom != null && _renderData != null)
        {
            _selectedRoomDoors = _renderData.Doors.Where(d => d.RoomId == _selectedRoom.Id).ToArray();
        }
        StateHasChanged();
    }

    private void ClearSelection()
    {
        _selectedRoom = null;
        _selectedAgent = null;
        _selectedRoomAgents = [];
        _selectedRoomObjects = [];
        _selectedRoomDoors = [];
        StateHasChanged();
    }

    private async Task MoveSelectedAgent()
    {
        if (_selectedAgent == null || _renderData == null) return;
        var rng = new Random();
        var targetRoom = _renderData.Rooms[rng.Next(_renderData.Rooms.Length)];
        await JS.InvokeVoidAsync("WorldRenderer.moveAgent", "world-canvas",
            _selectedAgent.Id, targetRoom.X + targetRoom.Width / 2, targetRoom.Y + targetRoom.Height / 2);
        ClearSelection();
    }

    public void Dispose()
    {
        _selfRef?.Dispose();
    }
}
